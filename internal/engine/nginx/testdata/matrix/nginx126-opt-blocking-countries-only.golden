## /etc/nginx/conf.d/cloudground-block-199.conf
# Written by CloudGround: the visitors c199.example.test (site 199) refuses (#25).
# Country data: IP Geolocation by DB-IP (https://db-ip.com), CC BY 4.0.
geo $cg_block_ip_199 {
    default  0;
    127.0.0.0/8  x;
    192.0.2.10/32  x;
    ::1/128  x;
}
# The only countries served: IT SM.
geo $cg_block_cc_199 {
    default  1;
    2.32.0.0/11  0;
    2001:b07::/32  0;
}
map "$cg_block_ip_199$cg_block_cc_199" $cg_block_199 {
    default  1;
    "00"  0;
    "x0"  0;
    "x1"  0;
}
## /etc/nginx/sites-enabled/c199.example.test.conf
# Managed by CloudGround — do not edit. Changes are detected as drift.
# Site: c199.example.test (id 199, type static, profile balanced)

server {
    listen 80;
    listen [::]:80;
    server_name c199.example.test;

    location /.well-known/acme-challenge/ {
        root /srv/cgt/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name c199.example.test;
    server_tokens off;

    # Visitors this site refuses: addresses, countries, user agents (SPEC
    # §4.7, cloudground-block-199.conf). The server rewrite phase runs
    # before the page cache is read, so a refused visitor gets no cached page.
    if ($cg_block_199) {
        return 403;
    }

    # Send small responses at once. With Ubuntu's tcp_nopush and no
    # tcp_nodelay, the last packet of a kept-alive reply waits for the peer's
    # delayed ACK (40 ms); measured, that cut cached req/s by about ten times.
    tcp_nodelay on;
    tcp_nopush off;

    ssl_certificate /srv/cgt/fallback/cert.pem;
    ssl_certificate_key /srv/cgt/fallback/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:cg_ssl:10m;

    # Log lines go out in 64 KiB batches, at least once a second.
    access_log /srv/cgt/log/c199.example.test/access.log cloudground buffer=64k flush=1s;
    error_log /srv/cgt/log/c199.example.test/error.log warn;

    client_max_body_size 128m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;

    root /srv/cgt/sites/c199.example.test/current;
    index index.php index.html index.htm;
    disable_symlinks if_not_owner from=$document_root;

    location ~ /\.(?!well-known) {
        deny all;
    }

    # Leftovers are never served: backup and editor copies, SQL dumps, copies
    # of wp-config.php and archives at the top of the root (SPEC §4.4).
    location ~* (?:\.(?:bak|old|orig|save|swp|swo|sql|sql\.(?:gz|bz2|xz|zst|zip))|~|/wp-config\.php.+|^/[^/]+\.(?:tar|tar\.(?:gz|bz2|xz|zst)|tgz|tbz2|txz|zip|7z|rar))$ {
        return 404;
    }

    location ~* \.(css|js|mjs|jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|eot|otf|mp4|webm|pdf)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
        # A served asset is not worth a log line; one that failed (a missing
        # image) is, for the traffic statistics' not-found list (#33).
        access_log /srv/cgt/log/c199.example.test/access.log cloudground buffer=64k flush=1s if=$cg_asset_failed;
        # A deploy writes .gz copies; send those rather than gzip each time.
        gzip_static on;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html =404;
    }
}
