## /etc/nginx/sites-enabled/c115.example.test.conf
# Managed by CloudGround — do not edit. Changes are detected as drift.
# Site: c115.example.test (id 115, type proxy, profile balanced)

map $http_x_cloudground_internal $cg_staging_realm_115 {
    "d22221758bcdd57938e8e8af0dab6446"  off;
    default  "Staging";
}

server {
    listen 80;
    listen [::]:80;
    server_name c115.example.test;

    location /.well-known/acme-challenge/ {
        root /srv/cgt/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name c115.example.test;
    server_tokens off;

    # A staging copy asks for a password. CloudGround's own requests (guard
    # probes, warming, connector flushes) skip it with a header key kept in
    # a file only root reads; 127.0.0.1 gets no pass, since PHP runs here.
    auth_basic $cg_staging_realm_115;
    auth_basic_user_file /srv/cgt/auth/c115.example.test.htpasswd;

    # Send small responses at once. With Ubuntu's tcp_nopush and no
    # tcp_nodelay, the last packet of a kept-alive reply waits for the peer's
    # delayed ACK (40 ms); measured, that cut cached req/s by about ten times.
    tcp_nodelay on;
    tcp_nopush off;

    ssl_certificate /srv/cgt/certs/c115.example.test/fullchain.pem;
    ssl_certificate_key /srv/cgt/certs/c115.example.test/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:cg_ssl:10m;

    # Log lines go out in 64 KiB batches, at least once a second.
    access_log /srv/cgt/log/c115.example.test/access.log cloudground buffer=64k flush=1s;
    error_log /srv/cgt/log/c115.example.test/error.log warn;

    client_max_body_size 128m;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000" always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 60s;
    }
}
