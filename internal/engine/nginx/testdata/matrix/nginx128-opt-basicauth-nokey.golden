## /etc/nginx/sites-enabled/c150.example.test.conf
# Managed by CloudGround — do not edit. Changes are detected as drift.
# Site: c150.example.test (id 150, type static, profile balanced)

map $http_x_cloudground_internal $cg_staging_realm_150 {
    default  "Staging";
}

server {
    listen 80;
    listen [::]:80;
    server_name c150.example.test;

    location /.well-known/acme-challenge/ {
        root /srv/cgt/acme;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    # HTTP/3 over QUIC, present because this nginx has the v3 module.
    # "reuseport" is allowed once per address and this file is one site
    # among many, so the default server set up at install time holds it.
    listen 443 quic;
    listen [::]:443 quic;
    server_name c150.example.test;
    server_tokens off;

    # A staging copy asks for a password. CloudGround's own requests (guard
    # probes, warming, connector flushes) skip it with a header key kept in
    # a file only root reads; 127.0.0.1 gets no pass, since PHP runs here.
    auth_basic $cg_staging_realm_150;
    auth_basic_user_file /srv/cgt/auth/c150.example.test.htpasswd;

    # Send small responses at once. With Ubuntu's tcp_nopush and no
    # tcp_nodelay, the last packet of a kept-alive reply waits for the peer's
    # delayed ACK (40 ms); measured, that cut cached req/s by about ten times.
    tcp_nodelay on;
    tcp_nopush off;

    ssl_certificate /srv/cgt/fallback/cert.pem;
    ssl_certificate_key /srv/cgt/fallback/key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:cg_ssl:10m;

    # Log lines go out in 64 KiB batches, at least once a second.
    access_log /srv/cgt/log/c150.example.test/access.log cloudground buffer=64k flush=1s;
    error_log /srv/cgt/log/c150.example.test/error.log warn;

    client_max_body_size 128m;
    http3 on;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;

    root /srv/cgt/sites/c150.example.test/current;
    index index.php index.html index.htm;
    disable_symlinks if_not_owner from=$document_root;

    location ~ /\.(?!well-known) {
        deny all;
    }

    # Leftovers are never served: backup and editor copies, SQL dumps, copies
    # of wp-config.php and archives at the top of the root (SPEC §4.4).
    location ~* (?:\.(?:bak|old|orig|save|swp|swo|sql|sql\.(?:gz|bz2|xz|zst|zip))|~|/wp-config\.php.+|^/[^/]+\.(?:tar|tar\.(?:gz|bz2|xz|zst)|tgz|tbz2|txz|zip|7z|rar))$ {
        return 404;
    }

    location ~* \.(css|js|mjs|jpg|jpeg|png|gif|webp|avif|svg|ico|woff|woff2|ttf|eot|otf|mp4|webm|pdf)$ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Alt-Svc 'h3=":443"; ma=86400' always;
        # A served asset is not worth a log line; one that failed (a missing
        # image) is, for the traffic statistics' not-found list (#33).
        access_log /srv/cgt/log/c150.example.test/access.log cloudground buffer=64k flush=1s if=$cg_asset_failed;
        # A deploy writes .gz copies; send those rather than gzip each time.
        gzip_static on;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ /index.html =404;
    }
}
