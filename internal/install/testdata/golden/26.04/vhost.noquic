# Managed by CloudGround — default servers and the panel's own port
server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name _;
    server_tokens off;
    location /.well-known/acme-challenge/ { root /var/www/cloudground-acme; }
    location / { return 444; }
}
server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    server_name _;
    server_tokens off;
    ssl_certificate /etc/cloudground/certs/fallback.pem;
    ssl_certificate_key /etc/cloudground/certs/fallback.key;
    location / { return 444; }
}
server {
    listen 8443 ssl default_server;
    listen [::]:8443 ssl default_server;
    server_name _;
    server_tokens off;
    ssl_certificate /etc/cloudground/certs/panel-ip.pem;
    ssl_certificate_key /etc/cloudground/certs/panel-ip.key;
    # Plain HTTP sent to this port goes to its HTTPS form.
    error_page 497 =301 https://$http_host$request_uri;
    include /etc/cloudground/panel-access.conf*;
    # The API's per-file transfer limit (16 MB); nginx's 1 MB default refused
    # every larger upload with a 413 before it reached the panel (measured).
    client_max_body_size 16m;
    location / {
        proxy_pass http://unix:/run/cloudground/api.sock;
        proxy_buffering off;
        proxy_read_timeout 1h;
        # With the port: the API checks Origin against Host on every write.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }
}
