[Unit]
Description=CloudGround control panel API
After=network.target cloudground-agent.service cloudground-api.socket
Wants=cloudground-agent.service
Requires=cloudground-api.socket

[Service]
Type=simple
User=cloudground
Group=cloudground
UMask=0027
EnvironmentFile=-/etc/cloudground/panel.env
ExecStart=/usr/local/bin/panel-api
Sockets=cloudground-api.socket
Restart=on-failure
RestartSec=2

# The API faces the browser, so it gets no privilege at all: anything that
# needs root is a request to the agent over its socket.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/cloudground
PrivateTmp=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
# AF_NETLINK (routing, read only without capabilities) lets it list this
# machine's addresses: a block or a site rule holding them is refused, and
# a webhook may not post to them. Without it the list was empty, and every
# webhook was refused as "this server's own".
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
