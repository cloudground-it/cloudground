[Unit]
Description=CloudGround privileged agent
After=network.target mariadb.service nginx.service
Wants=mariadb.service nginx.service

[Service]
Type=simple
UMask=0027
EnvironmentFile=-/etc/cloudground/panel.env
# The agent's restic cache: /root is read-only for this unit (ProtectHome).
Environment=RESTIC_CACHE_DIR=/var/cache/cloudground/restic
# The system packages this release needs (internal/syspkg), the missing ones
# installed through a transient root unit, before the agent starts (#113,
# ops/panel SPEC §2.6): a self-update gets a package its release added. While
# an update is applied a failure fails this start and the guard rolls the
# update back; at any other start the agent starts anyway. It takes at most
# 100 s, inside the guard's 2-minute wait for the restart.
ExecStartPre=/usr/local/bin/panel-agent ensure-packages
TimeoutStartSec=3min
ExecStart=/usr/local/bin/panel-agent
Restart=on-failure
RestartSec=2

# The agent's own memory (#66, bench/agent-memory.md): a backstop against
# its growth, provisional until measured. restic, mariadb-dump, the mariadb
# client and certbot run in units of their own (cg-helper.slice), so this
# limit never cuts a backup or a restore. Past MemoryHigh the kernel reclaims
# and throttles; MemoryMax is the hard stop, after which systemd restarts
# the agent. A child killed for memory (nginx -t, apt-get) fails its own
# request only: OOMPolicy=continue keeps the agent running.
MemoryHigh=768M
MemoryMax=1G
OOMPolicy=continue

RuntimeDirectory=cloudground cloudground/php
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes

# The agent is root because its work is root's work: users, nginx, PHP-FPM,
# MariaDB, certificates, the firewall. The sandbox below still bounds it, and
# every child it spawns (useradd, nginx -t, ufw) inherits it. Its helpers
# (restic, mariadb-dump, the mariadb client, certbot) run in units of their
# own with these same lines (host.HelperProps, held to this file by a test);
# wp-cli runs in its site's sandbox.
#
# It may write only: /etc, the site trees, its own state, cache and log
# directories, the ACME webroot and certbot's state, cron's spool, /run and
# /usr/local/bin (where self-update puts binaries). /usr, /boot and the rest
# of the system are read-only, and so are /home and /root.
ProtectSystem=strict
ReadWritePaths=/etc /srv/sites /var/lib/cloudground-agent /var/cache/cloudground /var/log /var/lib/letsencrypt /var/www/cloudground-acme /var/spool/cron /run /usr/local/bin
# Optional: a local restic repository under /var/backups or a mount in /mnt.
ReadWritePaths=-/var/backups -/mnt
ProtectHome=read-only
PrivateTmp=yes
NoNewPrivileges=yes
# RestrictSUIDSGID is left out on purpose. Its seccomp filter cannot look at
# openat2's arguments and so fails every openat2 call with ENOSYS; the
# agent's symlink-safe file access is built on openat2, and with the option
# on, every site provision failed (measured).
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
# ufw reaches netfilter over netlink.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
# NET_BIND_SERVICE is for "nginx -t", which binds every configured listener
# (80, 443, and 443/udp with HTTP/3) to test it.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_CHOWN CAP_DAC_OVERRIDE CAP_DAC_READ_SEARCH CAP_FOWNER CAP_FSETID CAP_KILL CAP_SETUID CAP_SETGID CAP_SETPCAP CAP_NET_ADMIN CAP_NET_RAW CAP_AUDIT_WRITE CAP_SYS_RESOURCE

[Install]
WantedBy=multi-user.target
