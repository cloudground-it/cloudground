table alerts on alerts
  create table alerts(id integer primary key autoincrement,key text not null unique,public_id text not null unique,kind text not null,site_id integer references sites(id)on delete cascade,subject text not null default '',level text not null,fingerprint text not null default '',message text not null,text_key text not null default '',text_count integer not null default -1,text_args text not null default '[]',detail_key text not null default '',detail_args text not null default '[]',at text not null default '',raised_at text not null,seen_at text not null,dismissed_at text,notified_at text)
table api_tokens on api_tokens
  create table api_tokens(id integer primary key autoincrement,user_id integer not null references users(id)on delete cascade,name text not null,token_hash text not null unique,hint text not null,created_at text not null,expires_at text not null default '',last_used_at text not null default '')
table audit_events on audit_events
  create table audit_events(id integer primary key autoincrement,actor text not null,action text not null,subject text not null,detail text not null default '',created_at text not null)
table backups on backups
  create table backups(id integer primary key autoincrement,site_id integer not null references sites(id)on delete cascade,snapshot_id text not null,repository text not null,size_bytes integer not null default 0,kind text not null,verify_status text not null default 'pending',verified_at text,restore_est_ms integer not null default 0,created_at text not null,databases text)
table cron_jobs on cron_jobs
  create table cron_jobs(id integer primary key autoincrement,site_id integer not null references sites(id)on delete cascade,schedule text not null,command text not null,description text not null default '',enabled integer not null default 1,last_run text,last_status text not null default '',created_at text not null)
table deployments on deployments
  create table deployments(id integer primary key autoincrement,site_id integer not null references sites(id)on delete cascade,release_id text not null,path text not null,checksum text not null default '',status text not null,guard_json text not null default '',created_at text not null,promoted_at text,rollback_to text not null default '',regressed integer not null default 0,note text not null default '',unique(site_id,release_id))
table drift_events on drift_events
  create table drift_events(id integer primary key autoincrement,path text not null,expected_hash text not null,actual_hash text not null,status text not null default 'open',detected_at text not null,resolved_at text)
table jobs on jobs
  create table jobs(id integer primary key autoincrement,kind text not null,site_id integer not null default 0,status text not null,progress integer not null default 0,message text not null default '',log_head text not null default '',log_tail text not null default '',log_dropped integer not null default 0,error text not null default '',error_key text not null default '',error_args text not null default '',payload text not null default '{}',locks text not null default '[]',dedup_key text,quiet integer not null default 0,attempts integer not null default 0,cancel_requested integer not null default 0,background integer not null default 0,not_before text,created_at text not null,started_at text,finished_at text)
table managed_files on managed_files
  create table managed_files(path text primary key,sha256 text not null,updated_at text not null)
table meta on meta
  create table meta(key text primary key,value text not null)
table metric_samples on metric_samples
  create table metric_samples(id integer primary key autoincrement,cpu_headroom_pct integer not null,mem_headroom_pct integer not null,disk_headroom_pct integer not null,load1 real not null,sampled_at text not null)
table panel_settings on panel_settings
  create table panel_settings(id integer primary key check(id=1),acme_email text not null default '',panel_domain text not null default '',probe_target text not null default '',backup_repository text not null default '',backup_s3_access_key text not null default '',backup_s3_region text not null default '',require_2fa_admin integer not null default 0,update_check integer not null default 1,update_channel text not null default 'stable' check(update_channel in('stable','beta')))
table schedule_state on schedule_state
  create table schedule_state(key text primary key,last_run text not null)
table schema_migrations on schema_migrations
  create table schema_migrations(version integer primary key,applied_at text not null)
table secrets on secrets
  create table secrets(name text primary key,site_id integer references sites(id)on delete cascade,sealed blob not null,updated_at text not null,lookup text)
table sessions on sessions
  create table sessions(token_hash text primary key,user_id integer not null references users(id)on delete cascade,expires_at text not null,created_at text not null,last_seen_at text not null default '',user_agent text not null default '',ip text not null default '')
table settings on settings
  create table settings(key text primary key,value text not null)
table setup_tokens on setup_tokens
  create table setup_tokens(token_hash text primary key,expires_at text not null,used integer not null default 0)
table site_databases on site_databases
  create table site_databases(id integer primary key autoincrement,site_id integer not null references sites(id)on delete cascade,name text not null unique,created_at text not null)
table site_db_grants on site_db_grants
  create table site_db_grants(user_id integer not null references site_db_users(id)on delete cascade,database_id integer not null references site_databases(id)on delete cascade,level text not null check(level in('all','read')),primary key(user_id,database_id))
table site_db_users on site_db_users
  create table site_db_users(id integer primary key autoincrement,site_id integer not null references sites(id)on delete cascade,name text not null unique,secret text not null,created_at text not null)
table site_status on site_status
  create table site_status(site_id integer primary key references sites(id)on delete cascade,cert_expiry text not null default '',cert_error text not null default '')
table site_usage on site_usage
  create table site_usage(id integer primary key autoincrement,site_id integer not null references sites(id)on delete cascade,sampled_at text not null,cpu_usec integer not null,io_read_bytes integer not null,io_write_bytes integer not null,cpu_cores real not null,mem_bytes integer not null,mem_max_bytes integer not null,io_read_bps real not null,io_write_bps real not null,tasks integer not null,oom_kills integer not null,disk_bytes integer not null,disk_inodes integer not null)
table site_usage_hourly on site_usage_hourly
  create table site_usage_hourly(site_id integer not null references sites(id)on delete cascade,hour text not null,n integer not null,cpu_cores_sum real not null,cpu_cores_max real not null,mem_bytes_sum real not null,mem_bytes_max integer not null,mem_max_bytes integer not null,io_read_sum real not null,io_write_sum real not null,disk_bytes integer not null,primary key(site_id,hour))
table sites on sites
  create table sites(id integer primary key autoincrement,domain text not null unique,aliases text not null default '[]',type text not null,profile text not null,engine text not null default 'nginx',php_version text not null default '',system_user text not null,root_path text not null,status text not null,staging_of integer not null default 0,config text not null default '{}',created_at text not null,updated_at text not null,desired_generation integer not null default 1,applied_generation integer not null default 0,last_apply_error text not null default '')
table sqlite_sequence on sqlite_sequence
  create table sqlite_sequence(name,seq)
table user_sites on user_sites
  create table user_sites(user_id integer not null references users(id)on delete cascade,site_id integer not null references sites(id)on delete cascade,primary key(user_id,site_id))
table users on users
  create table users(id integer primary key autoincrement,email text not null unique,password_hash text not null,role text not null default 'admin',created_at text not null,totp_enabled integer not null default 0,totp_last_step integer not null default 0,first_name text not null default '',last_name text not null default '',disabled integer not null default 0,locale text not null default '')

