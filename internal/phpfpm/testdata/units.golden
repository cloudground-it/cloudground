===== wordpress err=<nil>
# Managed by CloudGround — do not edit. Changes are detected as drift.
[Unit]
Description=PHP-FPM for site9.example.com
After=network.target mariadb.service

[Service]
Type=notify
User=cg-site-9
Group=cg-site-9
RuntimeDirectory=cloudground/php/cg-site-9
RuntimeDirectoryMode=0750
ExecStart=/usr/sbin/php-fpm8.4 --nodaemonize --fpm-config /etc/cloudground-php/cg-site-9.conf -d opcache.memory_consumption=64 -d opcache.interned_strings_buffer=8 -d opcache.max_accelerated_files=10000 -d opcache.jit=tracing -d opcache.jit_buffer_size=32M -d apc.shm_size=32M
ExecReload=/bin/kill -USR2 $MAINPID
Restart=on-failure
RestartSec=2
LimitNOFILE=65536

# The site sees its own tree and nothing of any other site: /srv/sites is an
# empty tmpfs with only this site bound into it, and the same for its logs.
# This, not open_basedir, is the tenant boundary. Its SysV shared memory,
# semaphores and POSIX queues are its own too (PrivateIPC).
ProtectSystem=strict
TemporaryFileSystem=/srv/sites:ro /var/log/cloudground:ro
TemporaryFileSystem=/dev/shm:size=64M,mode=1777,nosuid,nodev,noexec
BindPaths=/srv/sites/site9.example.com /var/log/cloudground/site9.example.com
ReadWritePaths=/srv/sites/site9.example.com /var/log/cloudground/site9.example.com
InaccessiblePaths=-/etc/nginx -/etc/cloudground -/etc/letsencrypt -/etc/mysql -/var/lib/cloudground -/var/lib/cloudground-agent -/var/cache/cloudground -/var/log/nginx -/var/backups
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectProc=invisible
ProcSubset=pid
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
CapabilityBoundingSet=
PrivateIPC=yes

[Install]
WantedBy=multi-user.target
