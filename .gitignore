# Build output. ui/dist is not here: it is committed for go:embed.
/bin/
/dist/
ui/node_modules/
ui/.nuxt/
ui/.output/
coverage.out

# SQLite files a local run leaves behind (the panel's state.db and its WAL).
*.db
*.db-wal
*.db-shm

# Anything that may hold a secret. ".env.*" too: .env.local and
# .env.production are how an env file usually slips into a commit.
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
*.token
id_rsa*
.netrc

# Editors and operating systems.
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Benchmark runs stay with whoever ran them.
bench/results/
